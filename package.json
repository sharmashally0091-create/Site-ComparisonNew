    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:comparison": "playwright test tests/comparison/navigation.spec.ts",
    "argos:upload": "ts-node scripts/argos-upload.ts",
    "test:visual": "npm run test:comparison && npm run argos:upload",
    "argos:staging": "ts-node scripts/argos-upload.ts staging",
    "argos:live": "ts-node scripts/argos-upload.ts live",
    "argos:diff": "ts-node scripts/argos-upload.ts diff",
    "baseline": "cross-env SNAPSHOT_ENV=baseline npm run test:comparison",
    "current": "cross-env SNAPSHOT_ENV=current npm run test:comparison",
    "argos:baseline": "npx argos upload snapshots/argos",
    "argos:current": "npx argos upload snapshots/argos"
    
  },
